{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["../extensions/opencode-tools/dist/index.js", "@harnessctl/opencode-tools@0.1.10"],
  "mcp": {
    "sdlc_cvs_github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GH_TOKEN}",
        "X-MCP-Toolsets": "repos,issues,pull_requests,actions,git"
      }
    },
    "sdlc_code_index": {
      "type": "local",
      "command": ["cgc", "mcp", "start"],
      "enabled": true,
      "timeout": 30000
    },
    "webcrawl_searchable": {
      "type": "local",
      "command": ["npx", "-y", "@dragoscirjan/mcp-searchable@latest"]
    }
  }
}
