{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@harnessctl/opencode-tools",
  "version": "0.1.7",
  "description": "OpenCode tools for harnessctl.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dragoscirjan/harnessctl-v2.git",
    "directory": "extensions/opencode-tools"
  },
  "homepage": "https://github.com/dragoscirjan/harnessctl-v2#readme",
  "bugs": "https://github.com/dragoscirjan/harnessctl-v2/issues",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --config ../../vitest.config.ts --exclude integration.test.ts --passWithNoTests",
    "test:integration": "vitest run --config ../../vitest.config.ts integration.test.ts --retry=1",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@harnessctl/generic-tools": "0.1.7",
    "@opencode-ai/plugin": "1.18.2"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.2",
    "@opencode-ai/sdk": "^1.18.2",
    "opencode-ai": "^1.18.2"
  }
}
