{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@harnessctl/opencode-tools",
  "version": "0.1.0",
  "description": "OpenCode tools for harnessctl.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --config ../../vitest.config.ts --exclude integration.test.ts --passWithNoTests",
    "test:integration": "vitest run --config ../../vitest.config.ts integration.test.ts --retry=1",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@harnessctl/generic-tools": "0.1.0",
    "@opencode-ai/plugin": "1.18.2"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.2",
    "@opencode-ai/sdk": "^1.18.2",
    "opencode-ai": "^1.18.2"
  }
}
