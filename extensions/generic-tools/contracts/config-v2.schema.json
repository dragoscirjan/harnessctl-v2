{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnessctl.dev/contracts/config-v2.schema.json",
  "title": "harnessctl project configuration v2",
  "description": "Repository paths are project-relative. The local SQLite cache uses the fixed .harnessctl/cache/harnessctl.sqlite path.",
  "allOf": [
    {
      "if": {
        "properties": {
          "memory": {
            "type": "object",
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": ["enabled"]
          }
        },
        "required": ["memory"]
      },
      "then": {
        "properties": {
          "communication": {
            "type": "object",
            "properties": {
              "caveman": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": ["enabled"]
              }
            },
            "required": ["caveman"]
          }
        },
        "required": ["communication"]
      }
    }
  ],
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 2
    },
    "issues": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "root": {
              "type": "string",
              "minLength": 1,
              "allOf": [
                {
                  "pattern": "\\S"
                },
                {
                  "pattern": "^(?!\\/)(?![A-Za-z]:)(?!.*[\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029])(?!.*\\\\)(?!.*`)(?!.*\\/\\/)(?!.*\\/$)(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$)).+$"
                }
              ]
            },
            "prefix": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]*$"
            },
            "type": {
              "type": "string",
              "const": "filesystem"
            },
            "tools": {
              "type": "string",
              "const": "issue_id,issue_create,issue_list,issue_get,issue_update,issue_transition,issue_comment,issue_relate,issue_unrelate,issue_link_document,issue_validate,issue_archive"
            }
          },
          "required": ["root", "prefix", "type", "tools"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "root": {
              "type": "string",
              "minLength": 1,
              "allOf": [
                {
                  "pattern": "\\S"
                },
                {
                  "pattern": "^(?!\\/)(?![A-Za-z]:)(?!.*[\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029])(?!.*\\\\)(?!.*`)(?!.*\\/\\/)(?!.*\\/$)(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$)).+$"
                }
              ]
            },
            "prefix": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]*$"
            },
            "type": {
              "type": "string",
              "const": "github"
            },
            "tools": {
              "type": "string",
              "const": "gh"
            }
          },
          "required": ["root", "prefix", "type", "tools"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "root": {
              "type": "string",
              "minLength": 1,
              "allOf": [
                {
                  "pattern": "\\S"
                },
                {
                  "pattern": "^(?!\\/)(?![A-Za-z]:)(?!.*[\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029])(?!.*\\\\)(?!.*`)(?!.*\\/\\/)(?!.*\\/$)(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$)).+$"
                }
              ]
            },
            "prefix": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]*$"
            },
            "type": {
              "type": "string",
              "const": "gitlab"
            },
            "tools": {
              "type": "string",
              "const": "glab"
            }
          },
          "required": ["root", "prefix", "type", "tools"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "root": {
              "type": "string",
              "minLength": 1,
              "allOf": [
                {
                  "pattern": "\\S"
                },
                {
                  "pattern": "^(?!\\/)(?![A-Za-z]:)(?!.*[\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029])(?!.*\\\\)(?!.*`)(?!.*\\/\\/)(?!.*\\/$)(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$)).+$"
                }
              ]
            },
            "prefix": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]*$"
            },
            "type": {
              "type": "string",
              "const": "gitea"
            },
            "tools": {
              "type": "string",
              "const": "tea"
            }
          },
          "required": ["root", "prefix", "type", "tools"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "root": {
              "type": "string",
              "minLength": 1,
              "allOf": [
                {
                  "pattern": "\\S"
                },
                {
                  "pattern": "^(?!\\/)(?![A-Za-z]:)(?!.*[\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029])(?!.*\\\\)(?!.*`)(?!.*\\/\\/)(?!.*\\/$)(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$)).+$"
                }
              ]
            },
            "prefix": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]*$"
            },
            "type": {
              "type": "string",
              "const": "forgejo"
            },
            "tools": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          },
          "required": ["root", "prefix", "type", "tools"],
          "additionalProperties": false
        }
      ]
    },
    "communication": {
      "type": "object",
      "properties": {
        "caveman": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "mode": {
              "type": "string",
              "enum": ["strict", "balanced"]
            }
          },
          "required": ["enabled", "mode"],
          "additionalProperties": false
        }
      },
      "required": ["caveman"],
      "additionalProperties": false
    },
    "memory": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "backend": {
          "type": "string",
          "const": "repository"
        },
        "namespace": {
          "type": "object",
          "properties": {
            "organization_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "project_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "default_topic": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": ["organization_id", "project_id", "default_topic"],
          "additionalProperties": false
        },
        "retrieval": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "max_chars": {
              "type": "integer",
              "minimum": 256,
              "maximum": 100000
            },
            "include_superseded": {
              "type": "boolean"
            }
          },
          "required": ["limit", "max_chars", "include_superseded"],
          "additionalProperties": false
        },
        "repository": {
          "type": "object",
          "properties": {
            "root": {
              "type": "string",
              "minLength": 1,
              "allOf": [
                {
                  "pattern": "\\S"
                },
                {
                  "pattern": "^(?!\\/)(?![A-Za-z]:)(?!.*[\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029])(?!.*\\\\)(?!.*`)(?!.*\\/\\/)(?!.*\\/$)(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$)).+$"
                }
              ]
            }
          },
          "required": ["root"],
          "additionalProperties": {}
        }
      },
      "required": ["enabled", "backend", "namespace", "retrieval", "repository"],
      "additionalProperties": false
    }
  },
  "required": ["version", "issues", "communication", "memory"],
  "additionalProperties": {}
}
