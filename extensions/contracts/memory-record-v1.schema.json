{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnessctl.dev/contracts/memory-record-v1.schema.json",
  "title": "harnessctl portable memory record v1",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "memory_type",
        "record_type",
        "organization_id",
        "project_id",
        "topic",
        "summary",
        "details",
        "source",
        "created_at",
        "created_by",
        "confidence",
        "status",
        "supersedes",
        "tags"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "id": { "$ref": "#/$defs/ulid" },
        "memory_type": { "enum": ["semantic", "episodic", "procedural"] },
        "record_type": { "enum": ["fact", "decision", "event", "lesson"] },
        "organization_id": { "$ref": "#/$defs/nonempty" },
        "project_id": { "$ref": "#/$defs/nonempty" },
        "topic": { "$ref": "#/$defs/nonempty" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "details": { "type": ["string", "null"], "maxLength": 12000 },
        "source": { "$ref": "#/$defs/source" },
        "created_at": { "type": "string", "format": "date-time" },
        "created_by": { "$ref": "#/$defs/nonempty" },
        "confidence": { "enum": ["confirmed", "verified"] },
        "status": { "const": "active" },
        "supersedes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/ulid" } },
        "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "organization_id",
        "project_id",
        "target_id",
        "reason",
        "source",
        "created_at",
        "created_by"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "id": { "$ref": "#/$defs/ulid" },
        "organization_id": { "$ref": "#/$defs/nonempty" },
        "project_id": { "$ref": "#/$defs/nonempty" },
        "target_id": { "$ref": "#/$defs/ulid" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "source": { "$ref": "#/$defs/source" },
        "created_at": { "type": "string", "format": "date-time" },
        "created_by": { "$ref": "#/$defs/nonempty" }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "ulid": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "nonempty": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "required": ["kind", "ref", "revision"],
      "properties": {
        "kind": { "enum": ["artifact", "user-confirmed", "discussion", "tool-observation"] },
        "ref": { "type": ["string", "null"] },
        "revision": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}
