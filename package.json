{
  "name": "harnessctl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["extensions/*"],
  "scripts": {
    "prepare": "husky",
    "contracts:generate": "npm run contracts:generate --workspace @harnessctl/generic-tools",
    "lint": "npx eslint \"extensions/**/*.{ts,js,mjs,cjs}\"",
    "lint:fix": "npm run lint -- --fix",
    "format": "npx prettier --check README.md \"extensions/**/*.{ts,js,json,md,yml,yaml}\"",
    "format:fix": "npx prettier --write README.md \"extensions/**/*.{ts,js,json,md,yml,yaml}\"",
    "dupcheck": "jscpd --config .jscpd.json",
    "pretest": "npm run build --workspace @harnessctl/generic-tools",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "fallow:summary": "npx fallow --summary || true",
    "fallow:check": "npx fallow --summary --fail-on-issues",
    "fallow:audit": "npx fallow audit --base refactor",
    "fallow:dead-code": "npx fallow dead-code",
    "fallow:dupes": "npx fallow dupes",
    "fallow:health": "npx fallow health",
    "pretypecheck:strict": "npm run build --workspace @harnessctl/generic-tools",
    "typecheck:strict": "npm run typecheck --workspaces --if-present",
    "typecheck": "npm run typecheck:strict || true",
    "quality": "mise run quality",
    "validate": "mise run quality",
    "quality:fix": "mise run format-fix && mise run lint-fix"
  },
  "devDependencies": {
    "@jscpd/html-reporter": "^4.2.5",
    "@templ-project/eslint": "^1.3.0",
    "@templ-project/prettier": "^1.1.0",
    "@templ-project/vitest": "^0.3.2",
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@vitest/coverage-v8": "3.2.7",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "fallow": "^3.3.0",
    "husky": "^9.1.7",
    "jscpd": "^5.0.12",
    "tsx": "^4.23.12",
    "typescript": "^5.8.2"
  },
  "prettier": "@templ-project/prettier"
}
