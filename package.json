{
  "name": "harnessctl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["extensions/*"],
  "scripts": {
    "prepare": "husky",
    "contracts:generate": "npm run contracts:generate --workspace @harnessctl/generic-tools",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only",
    "packages:build": "npm run build --workspace @harnessctl/generic-tools && npm run build --workspace @harnessctl/opencode-tools && npm run build --workspace @harnessctl/pi-tools",
    "packages:check": "npm run packages:build && node scripts/check-packages.mjs",
    "release": "npm run packages:check && changeset publish",
    "mermaid:check": "node scripts/check-mermaid.mjs",
    "lint": "npx eslint .",
    "lint:fix": "npm run lint -- --fix",
    "format": "npx prettier --check \"**/*.{js,mjs,cjs,ts,tsx,jsx,json,jsonc,md,mdx,yml,yaml,toml,css,scss,html}\"",
    "format:fix": "npx prettier --write \"**/*.{js,mjs,cjs,ts,tsx,jsx,json,jsonc,md,mdx,yml,yaml,toml,css,scss,html}\"",
    "dupcheck": "jscpd --config .jscpd.json",
    "pretest": "npm run build --workspace @harnessctl/generic-tools",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "fallow:summary": "npx fallow --summary || true",
    "fallow:check": "npx fallow --summary --fail-on-issues",
    "fallow:audit": "npx fallow audit --base refactor",
    "fallow:dead-code": "npx fallow dead-code",
    "fallow:dupes": "npx fallow dupes",
    "fallow:health": "npx fallow health",
    "pretypecheck:strict": "npm run build --workspace @harnessctl/generic-tools",
    "typecheck:strict": "npm run typecheck --workspaces --if-present",
    "typecheck": "npm run typecheck:strict || true",
    "quality": "mise run quality",
    "validate": "mise run quality",
    "quality:fix": "mise run format-fix && mise run lint-fix"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.0",
    "@jscpd/html-reporter": "^4.2.5",
    "@templ-project/eslint": "^1.3.0",
    "@templ-project/prettier": "^1.1.0",
    "@templ-project/vitest": "^0.3.2",
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@vitest/coverage-v8": "3.2.7",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "fallow": "^3.3.0",
    "husky": "^9.1.7",
    "jscpd": "^5.0.12",
    "jsdom": "29.0.0",
    "mermaid": "11.16.1",
    "tsx": "^4.23.12",
    "typescript": "^5.8.2"
  },
  "prettier": "@templ-project/prettier"
}
