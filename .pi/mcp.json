{
  "mcpServers": {
    "sdlc_cvs_github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GH_TOKEN}",
        "X-MCP-Toolsets": "repos,issues,pull_requests,actions,git"
      },
      "lifecycle": "lazy"
    },
    "sdlc_code_index": {
      "command": "cgc",
      "args": [
        "mcp",
        "start"
      ],
      "lifecycle": "lazy",
      "requestTimeoutMs": 30000
    },
    "webcrawl_searchable": {
      "command": "npx",
      "args": [
        "-y",
        "@dragoscirjan/mcp-searchable@latest"
      ],
      "lifecycle": "lazy"
    }
  },
  "settings": {
    "outputGuard": {
      "maxBytes": 51200,
      "maxLines": 2000,
      "detailsMaxBytes": 16384
    }
  }
}
