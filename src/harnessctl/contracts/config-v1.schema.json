  "title": "harnessctl project configuration v1",
  "description": "Capability-oriented harnessctl project configuration v1.",
  "allOf": [
    {
      "if": {
        "properties": {
          "skills": {
            "type": "object",
            "properties": {
              "memory": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": ["enabled"]
              }
            },
            "required": ["memory"]
          }
        },
        "required": ["skills"]
      },
      "then": {
        "properties": {
          "skills": {
            "type": "object",
            "properties": {
              "caveman": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": ["enabled"]
              }
            },
            "required": ["caveman"]
          }
        },
        "required": ["skills"]
      }
    }
